{
  "name": "@midnight-ntwrk/anonymous-survey-ui",
  "version": "0.1.0",
  "author": "Midnight Foundation",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf ./dist && vite build --mode preprod && mkdir -p ./dist/keys ./dist/zkir && (cp -r ../contract/src/managed/anonymous-survey/keys/* ./dist/keys/ 2>/dev/null || true) && (cp -r ../contract/src/managed/anonymous-survey/zkir/* ./dist/zkir/ 2>/dev/null || true)",
    "build:preview": "rm -rf ./dist && vite build --mode preview && mkdir -p ./dist/keys ./dist/zkir && (cp -r ../contract/src/managed/anonymous-survey/keys/* ./dist/keys/ 2>/dev/null || true) && (cp -r ../contract/src/managed/anonymous-survey/zkir/* ./dist/zkir/ 2>/dev/null || true)",
    "build:start": "npm run build && npm run start",
    "build:start:preview": "npm run build:preview && npm run start",
    "ci": "npm run typecheck && npm run lint",
    "dev": "vite",
    "lint": "eslint ./src",
    "start": "http-server --port 0 ./dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@midnight-ntwrk/dapp-connector-api": "4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.25.0",
    "fp-ts": "^2.16.11",
    "lucide-react": "^0.475.0",
    "node-stdlib-browser": "^1.3.1",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "7.17.0",
    "rollup": "^4.62.2",
    "rxjs": "^7.8.2",
    "semver": "^7.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.41",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "^0.25.0",
    "eslint-plugin-react": "^7.37.5",
    "rollup": "^4.62.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  }
}
