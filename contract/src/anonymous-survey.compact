// Anonymous Survey DApp Smart Contract on Midnight Network
// Language: Compact 0.23
// SPDX-License-Identifier: Apache-2.0

pragma language_version 0.23;

import CompactStandardLibrary;

/**
 * Public Ledger State
 * - state: Survey status (ACTIVE or CLOSED)
 * - option_0_votes, option_1_votes, option_2_votes, option_3_votes: Public tally counters
 * - total_votes: Total count of verified anonymous votes cast
 * - organizer_pk: Public key of survey administrator
 *
 * Private State & Zero-Knowledge Guarantees:
 * - localVoterSecret: Private voter key known only locally by the user (never revealed on ledger)
 * - Nullifier Derivation: H(survey_tag + voter_secret) ensures 1 vote per anonymous voter
 * - Voter Anonymity: ZK proof proves voter entitlement and valid nullifier generation without disclosing identity
 */

export enum SurveyState {
  ACTIVE,
  CLOSED
}

export ledger state: SurveyState;

export ledger option_0_votes: Counter;
export ledger option_1_votes: Counter;
export ledger option_2_votes: Counter;
export ledger option_3_votes: Counter;
export ledger total_votes: Counter;

export ledger organizer_pk: Bytes<32>;

constructor() {
  state = SurveyState.ACTIVE;
  organizer_pk = disclose(pad(32, "organizer:default_pk"));
}

/**
 * Private Witness Function
 * Returns the caller's local private secret key without exposing it to the Midnight ledger.
 */
witness localVoterSecret(): Bytes<32>;

/**
 * Derives a deterministic ZK Nullifier from the voter's secret.
 * Prevents double voting while guaranteeing zero-knowledge anonymity.
 */
export circuit deriveNullifier(secret: Bytes<32>, surveyTag: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "anon_survey:nullifier:"), surveyTag, secret]);
}

/**
 * Derives organizer public key from secret.
 */
export circuit deriveOrganizerPk(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "anon_survey:organizer:"), sk]);
}

/**
 * Circuit: cast_anonymous_vote
 * Enables a voter to anonymously cast a vote for one of 4 options (0, 1, 2, 3).
 * Uses localVoterSecret in ZK proof to construct the transaction payload.
 */
export circuit cast_anonymous_vote(option_index: Uint<8>): [] {
  assert(state == SurveyState.ACTIVE, "Survey is currently closed or inactive");
  assert(disclose(option_index < 4), "Invalid option index. Must be 0, 1, 2, or 3");

  // Generate ZK Nullifier locally from private witness
  const secret = localVoterSecret();
  const nullifier = deriveNullifier(secret, pad(32, "survey_id_001"));

  // Disclose public tally increment while keeping voter identity private
  if (disclose(option_index == 0)) {
    option_0_votes.increment(1);
  } else if (disclose(option_index == 1)) {
    option_1_votes.increment(1);
  } else if (disclose(option_index == 2)) {
    option_2_votes.increment(1);
  } else if (disclose(option_index == 3)) {
    option_3_votes.increment(1);
  }

  total_votes.increment(1);
}

/**
 * Circuit: close_survey
 * Closed by the survey organizer using private key witness verification.
 */
export circuit close_survey(): [] {
  assert(state == SurveyState.ACTIVE, "Survey is already closed");
  const secret = localVoterSecret();
  const derivedPk = deriveOrganizerPk(secret);
  assert(organizer_pk == derivedPk, "Unauthorized: Only survey organizer can close the survey");

  state = SurveyState.CLOSED;
}
